        android:fillColor="#1f1f1f"
        android:pathData="M290,610 H670 Q730,610 730,550 V420 Q730,360 670,360 H456 L438,303 Q430,284 406,284 H262 Q230,284 230,312 V550 Q230,610 290,610 Z" />

